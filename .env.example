# ApeGames Gotcha — environment variables (names only; never commit real values).
# On Lovable these are set as project secrets; locally copy to .env and fill in.

# --- Supabase (public values, also exposed to the browser via VITE_*) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server-only secrets ---
# Service role key (server functions, worker). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Privy sign-in verification (JWKS + linked accounts).
PRIVY_APP_SECRET=
# Operator key that signs GotchaVRF requestSpins / setPool transactions. Fund it with gas only.
VRF_OPERATOR_PRIVATE_KEY=
# Lovable AI Gateway (guide chat) and email sending.
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
# Firecrawl for ApeFest event knowledge (boredapeyachtclub.com only).
FIRECRAWL_API_KEY=
# Optional: X API bearer token. Enables automatic share verification when social.verification = "x_api".
X_BEARER_TOKEN=
# Cron auth for POST /api/worker/settle (Authorization: Bearer <secret>). _PREVIOUS allows rotation.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
