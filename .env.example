# Secret-free template. Real values live in Lovable → Cloud → Secrets (server) or the managed .env (public keys).

# --- Supabase (public; Lovable manages these) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server-only secrets (never prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Chainlink VRF operator (requests draws, publishes the pool). Must match GotchaVRF.operator().
VRF_OPERATOR_PRIVATE_KEY=
# Protects POST /api/cron/settle (the settlement worker). Rotate via LOVABLE_CRON_SECRET_PREVIOUS.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
# Archive-capable RPC for historical snapshot verification, one per chain id (ApeChain = 33139).
ARCHIVE_RPC_URL_33139=
# Optional: X API v2 app bearer token for automatic share verification (otherwise audited manual review).
X_API_BEARER_TOKEN=
# Sign-in and guide
PRIVY_APP_SECRET=
FIRECRAWL_API_KEY=

# --- Local tests only ---
# PostgreSQL 15+ server used by the database integration tests (each test creates/drops its own database).
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# Path to Foundry's anvil (chain integration tests).
ANVIL_BIN=anvil
